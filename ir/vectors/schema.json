    {
      "name": "reserved field",
      "why": "_-prefixed names are metadata",
      "schema": {
        "t": {
          "fields": {
            "_x": {
              "node": {
                "kind": "string"
              }
            }
          },
          "storage": "columns",
          "indexes": []
        }
      },
      "expect": {
        "error": {
          "tag": "SchemaError",
          "status": 400,
          "fields": {
            "reason": "reserved-field",
            "path": "_x"
          }
        }
      }
    },
