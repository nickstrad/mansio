{
  "category": "schema",
  "version": 1,
  "description": "Registered schema JSON -> its fingerprint text and sha256 fingerprint, or the declaration error.",
  "vectors": [
    {
      "name": "vector schema, columns",
      "why": "the schema every other vector uses",
      "schema": {
        "notes": {
          "fields": {
            "title": {
              "node": {
                "kind": "string"
              }
            },
            "score": {
              "node": {
                "kind": "number"
              }
            },
            "rank": {
              "node": {
                "kind": "integer"
              }
            },
            "done": {
              "node": {
                "kind": "boolean"
              }
            },
            "tag": {
              "node": {
                "kind": "enum",
                "values": [
                  "a",
                  "b"
                ],
                "nullable": true
              }
            },
            "tags": {
              "node": {
                "kind": "array",
                "item": {
                  "kind": "string"
                }
              }
            },
            "grid": {
              "node": {
                "kind": "array",
                "item": {
                  "kind": "integer"
                },
                "length": 3
              }
            },
            "owner": {
              "node": {
                "kind": "string",
                "nullable": true
              }
            }
          },
          "storage": "columns",
          "indexes": [
            {
              "name": "by_rank",
              "fields": [
                "rank"
              ]
            }
          ]
        },
        "lists": {
          "fields": {
            "name": {
              "node": {
                "kind": "string"
              }
            }
          },
          "storage": "columns",
          "indexes": []
        },
        "entries": {
          "fields": {
            "listId": {
              "node": {
                "kind": "string"
              }
            },
            "n": {
              "node": {
                "kind": "integer"
              }
            }
          },
          "storage": "columns",
          "indexes": [
            {
              "name": "by_list",
              "fields": [
                "listId",
                "n"
              ]
            }
          ]
        }
      },
      "expect": {
        "ok": true,
        "text": "{\"notes\":{\"fields\":{\"title\":{\"node\":{\"kind\":\"string\"}},\"score\":{\"node\":{\"kind\":\"number\"}},\"rank\":{\"node\":{\"kind\":\"integer\"}},\"done\":{\"node\":{\"kind\":\"boolean\"}},\"tag\":{\"node\":{\"kind\":\"enum\",\"values\":[\"a\",\"b\"],\"nullable\":true}},\"tags\":{\"node\":{\"kind\":\"array\",\"item\":{\"kind\":\"string\"}}},\"grid\":{\"node\":{\"kind\":\"array\",\"item\":{\"kind\":\"integer\"},\"length\":3}},\"owner\":{\"node\":{\"kind\":\"string\",\"nullable\":true}}},\"storage\":\"columns\",\"indexes\":[{\"name\":\"by_rank\",\"fields\":[\"rank\"]}]},\"lists\":{\"fields\":{\"name\":{\"node\":{\"kind\":\"string\"}}},\"storage\":\"columns\",\"indexes\":[]},\"entries\":{\"fields\":{\"listId\":{\"node\":{\"kind\":\"string\"}},\"n\":{\"node\":{\"kind\":\"integer\"}}},\"storage\":\"columns\",\"indexes\":[{\"name\":\"by_list\",\"fields\":[\"listId\",\"n\"]}]}}",
        "fingerprint": "sha256:72707455119e0803dbf0fe52c45ef0735b3b9765f2932c95d39e79a73b3a4ccb"
      }
    },
