# The soak's settings (scripts/soak/run.sh sources this; every value can be overridden from the environment).
# Times are seconds. The default is the shortened ~60 min run; the full soak is 72 h with nightly idle
# hours: scale LOAD1/IDLE/LOAD2 up (and repeat) for that.
: "${DBS:=300}"            # databases fb-0..fb-N-1 (one tenant)
: "${ZIPF:=1.1}"           # popularity skew: a warm head, a tail that passivates and re-warms
: "${CONC:=32}"            # client workers
: "${RATE:=400}"           # requests/s during load
: "${WRITE:=0.3}"          # write fraction
: "${MOVE_EVERY:=30s}"     # a controld move during load phases
: "${IDLE_RATE:=0.5}"      # requests/s during the idle phase ("near zero")
: "${LOAD1:=1500}"         # phase 1: load with fault windows
: "${IDLE:=600}"           # phase 2: near-idle (idle_after 3m: everything passivates)
: "${LOAD2:=1500}"         # phase 3: clean load (the slope window)
: "${SAMPLE_EVERY:=15}"    # sampler period
# Fault windows, seconds from the start of phase 1: dependency faults injected while under load.
: "${F_BREAKER_AT:=360}"   # trip vm-a's S3 breaker (mansioctl agent) …
: "${F_BREAKER_FOR:=60}"   # … for this long
: "${F_S3_AT:=600}"        # pause the SeaweedFS container (S3 silent) …
: "${F_S3_FOR:=45}"        # … for this long
: "${F_RESTART_AT:=900}"   # restart vm-b (SIGTERM, start again)
: "${F_PG_AT:=1140}"       # trip vm-b's placement (Postgres) breaker …
: "${F_PG_FOR:=60}"        # … for this long
