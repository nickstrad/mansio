{
  "name": "hot",
  "workers": 2048,
  "keep_dbs": true,
  "distribution": {
    "kind": "zipf",
    "s": 1.3
  },
  "mix": {
    "point_read": 40,
    "index_lookup": 10,
    "range_scan": 5,
    "aggregate": 3,
    "join": 4,
    "insert": 15,
    "update": 12,
    "upsert": 6,
    "bulk_insert": 4,
    "slow_cte": 0.5,
    "cross_join": 0.5
  },
  "phases": [
    {
      "name": "hot-5k",
      "dbs": 5000,
      "duration": "20s",
      "start_qps": 5000,
      "end_qps": 40000
    },
    {
      "name": "hot-5k-hold",
      "dbs": 5000,
      "duration": "20s",
      "start_qps": 40000,
      "shape": "step"
    },
    {
      "name": "write-heavy",
      "dbs": 5000,
      "duration": "20s",
      "start_qps": 20000,
      "shape": "step",
      "mix": {
        "point_read": 20,
        "insert": 40,
        "update": 30,
        "bulk_insert": 10
      }
    }
  ],
  "clients": [
    {
      "name": "good",
      "share": 0.7,
      "retry": {
        "max_attempts": 3,
        "backoff": "exponential",
        "base": "20ms",
        "max": "1s",
        "jitter": "full",
        "retry_on": [
          "shed",
          "aborted",
          "expired"
        ],
        "budget_ratio": 0.1,
        "total_timeout": "3s"
      }
    },
    {
      "name": "bad",
      "share": 0.3,
      "retry": {
        "max_attempts": 10,
        "backoff": "none",
        "jitter": "none",
        "retry_on": [
          "any"
        ]
      }
    }
  ]
}
