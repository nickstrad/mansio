-- auth_passwords: Better Auth's "<32 hex>:<128 hex>", one per user, a user that exists.
insert into auth_passwords (user_id, hash) values ('u1', repeat('a', 32) || ':' || repeat('b', 128));
INSERT 0 1
insert into auth_passwords (user_id, hash) values ('u1', repeat('a', 32) || ':' || repeat('b', 128));
ERROR:  duplicate key value violates unique constraint "auth_passwords_pkey"
  sqlstate 23505, constraint auth_passwords_pkey
insert into auth_passwords (user_id, hash) values ('nobody', repeat('a', 32) || ':' || repeat('b', 128));
ERROR:  insert or update on table "auth_passwords" violates foreign key constraint "auth_passwords_user_id_fkey"
  sqlstate 23503, constraint auth_passwords_user_id_fkey
insert into auth_passwords (user_id, hash) values ('u3', repeat('a', 31) || ':' || repeat('b', 128));
ERROR:  new row for relation "auth_passwords" violates check constraint "auth_passwords_hash_check"
  sqlstate 23514, constraint auth_passwords_hash_check
insert into auth_passwords (user_id, hash) values ('u3', repeat('A', 32) || ':' || repeat('b', 128));
ERROR:  new row for relation "auth_passwords" violates check constraint "auth_passwords_hash_check"
  sqlstate 23514, constraint auth_passwords_hash_check

-- auth_sessions: a 32-byte hash, an expiry after creation.
insert into auth_sessions (token_sha256, user_id, expires_at) values (sha256('t1'), 'u1', now() + interval '1 day');
INSERT 0 1
insert into auth_sessions (token_sha256, user_id, expires_at) values ('\x00', 'u1', now() + interval '1 day');
ERROR:  new row for relation "auth_sessions" violates check constraint "auth_sessions_token_sha256_check"
  sqlstate 23514, constraint auth_sessions_token_sha256_check
insert into auth_sessions (token_sha256, user_id, expires_at) values (sha256('t2'), 'u1', now() - interval '1 second');
ERROR:  new row for relation "auth_sessions" violates check constraint "auth_sessions_expiry_check"
  sqlstate 23514, constraint auth_sessions_expiry_check

-- memberships: known user and tenant, a role of two, one row per pair; deleting a user removes its rows.
insert into memberships (user_id, tenant_id) values ('u1', '00000000-0000-4000-8000-000000000001');
INSERT 0 1
insert into memberships (user_id, tenant_id) values ('u1', '00000000-0000-4000-8000-000000000001');
ERROR:  duplicate key value violates unique constraint "memberships_pkey"
  sqlstate 23505, constraint memberships_pkey
insert into memberships (user_id, tenant_id, role) values ('u3', '00000000-0000-4000-8000-000000000001', 'owner');
ERROR:  new row for relation "memberships" violates check constraint "memberships_role_check"
  sqlstate 23514, constraint memberships_role_check
insert into memberships (user_id, tenant_id) values ('nobody', '00000000-0000-4000-8000-000000000001');
ERROR:  insert or update on table "memberships" violates foreign key constraint "memberships_user_id_fkey"
  sqlstate 23503, constraint memberships_user_id_fkey
delete from auth_users where user_id = 'u1';
